set(required_executables PROFILE_TEST_EXECUTABLE)
if(NOT PROFILE_RUNNER_ONLY)
  list(APPEND required_executables PROFILE_PROBE_EXECUTABLE)
endif()
foreach(required IN LISTS required_executables)
  if(NOT DEFINED ${required} OR NOT EXISTS "${${required}}")
    message(FATAL_ERROR "${required} must name an existing executable")
  endif()
endforeach()
if(NOT DEFINED PROFILE_TEST_ROOT OR NOT IS_ABSOLUTE "${PROFILE_TEST_ROOT}")
  message(FATAL_ERROR "PROFILE_TEST_ROOT must be absolute")
endif()
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef nonce)
set(case_root "${PROFILE_TEST_ROOT}/lifecycle-${nonce}")
if(EXISTS "${case_root}")
  message(FATAL_ERROR "Refusing to reuse ${case_root}")
endif()
file(MAKE_DIRECTORY "${case_root}/temp" "${case_root}/fake-ambient")
file(REAL_PATH "${case_root}" case_root)
file(WRITE "${case_root}/.profile-driver" "${nonce}")
file(WRITE "${case_root}/shared-artifact.txt" "caller-owned artifact")
if(WIN32)
  set(preferences_suffix "AppData/Local/DREAM3DNX/preferences.json")
  set(home_variable "USERPROFILE")
elseif(APPLE)
  set(preferences_suffix "Library/Preferences/DREAM3DNX/preferences.json")
  set(home_variable "HOME")
else()
  set(preferences_suffix ".config/DREAM3DNX/preferences.json")
  set(home_variable "HOME")
endif()
set(fake_preferences "${case_root}/fake-ambient/${preferences_suffix}")
get_filename_component(fake_preferences_dir "${fake_preferences}" DIRECTORY)
file(MAKE_DIRECTORY "${fake_preferences_dir}")
set(sentinel "{\"plugins\":{},\"sentinel\":\"${nonce}\"}")
file(WRITE "${fake_preferences}" "${sentinel}")

# The driver owns its temporary parent. The generic helper must leave these variables unchanged.
set(ENV{TEMP} "${case_root}/temp")
set(ENV{TMP} "${case_root}/temp")
set(ENV{TMPDIR} "${case_root}/temp")
set(ENV{${home_variable}} "${case_root}/fake-ambient")
set(borrowed_env)
set(expected_borrowed "")
set(report_parent "${case_root}")

function(run_case name executable expected_status disposition)
  set(report "${report_parent}/${name}.profile")
  execute_process(
    COMMAND "${CMAKE_COMMAND}" -E env
      --unset=SIMPLNX_TEST_PROFILE_DIR --unset=SIMPLNX_TEST_PROFILE_TOKEN
      "SIMPLNX_TEST_PROFILE_REPORT=${report}" ${borrowed_env}
      "${executable}" ${ARGN}
    WORKING_DIRECTORY "${case_root}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
  file(WRITE "${case_root}/${name}.stdout" "${output}")
  file(WRITE "${case_root}/${name}.stderr" "${error}")
  if(expected_status STREQUAL "list")
    string(REGEX REPLACE "[^\n]" "" newlines "${output}")
    string(LENGTH "${newlines}" listed_count)
    if(listed_count LESS 256)
      message(FATAL_ERROR "Full discovery must cover more than 255 cases, found ${listed_count}")
    endif()
    set(expected_status "${listed_count}")
    if(NOT WIN32)
      math(EXPR expected_status "${listed_count} % 256")
    endif()
    if(NOT error STREQUAL "")
      message(FATAL_ERROR "Full discovery produced unexpected stderr: ${error}")
    endif()
  endif()
  if(NOT status STREQUAL "${expected_status}")
    message(FATAL_ERROR "${name}: status '${status}', expected '${expected_status}'. Evidence: ${case_root}\n${output}\n${error}")
  endif()
  file(READ "${fake_preferences}" actual_sentinel)
  file(READ "${case_root}/shared-artifact.txt" actual_artifact)
  if(NOT actual_sentinel STREQUAL sentinel OR NOT actual_artifact STREQUAL "caller-owned artifact")
    message(FATAL_ERROR "${name} changed external artifacts. Evidence: ${case_root}")
  endif()
  if(disposition STREQUAL "rejected")
    if(EXISTS "${report}")
      message(FATAL_ERROR "${name} installed a rejected profile")
    endif()
    return()
  endif()
  if(NOT EXISTS "${report}")
    message(FATAL_ERROR "${name} did not report its profile. Evidence: ${case_root}")
  endif()
  file(READ "${report}" active)
  file(TO_CMAKE_PATH "${active}" active)
  if(NOT IS_ABSOLUTE "${active}")
    message(FATAL_ERROR "${name} reported a relative profile")
  endif()
  get_filename_component(parent "${active}" DIRECTORY)
  get_filename_component(leaf "${active}" NAME)
  if(expected_borrowed STREQUAL "")
    if(NOT parent STREQUAL "${case_root}/temp" OR NOT leaf MATCHES "^simplnx-test-profile-[0-9]+-[0-9]+-[0-9]+$")
      message(FATAL_ERROR "${name} reported a profile outside the driver temporary parent: ${active}")
    endif()
  elseif(NOT active STREQUAL expected_borrowed)
    message(FATAL_ERROR "${name} did not use the declared borrowed fixture: ${active}")
  endif()
  if(disposition STREQUAL "removed")
    if(EXISTS "${active}")
      message(FATAL_ERROR "${name} left a successful automatic profile: ${active}")
    endif()
  elseif(disposition STREQUAL "late")
    file(READ "${active}/late-witness.txt" witness)
    if(NOT witness STREQUAL "isolated after removal" OR EXISTS "${active}/.simplnx-test-profile")
      message(FATAL_ERROR "Late routing did not recreate only its isolated witness: ${active}")
    endif()
  elseif(disposition STREQUAL "replaced")
    file(READ "${active}/unrelated.txt" replacement)
    if(NOT replacement STREQUAL "replacement must survive" OR NOT EXISTS "${active}-original/.simplnx-test-profile")
      message(FATAL_ERROR "Replaced root or original ownership evidence was removed")
    endif()
  elseif(NOT EXISTS "${active}/.simplnx-test-profile")
    message(FATAL_ERROR "${name} removed retained ownership evidence: ${active}")
  else()
    file(READ "${active}/.simplnx-test-profile" retained_token)
    if(disposition STREQUAL "tampered")
      set(expected_token "changed-token")
    elseif(NOT expected_borrowed STREQUAL "")
      set(expected_token "${nonce}")
    else()
      string(REGEX REPLACE "^simplnx-test-profile-" "" expected_token "${leaf}")
    endif()
    if(NOT retained_token STREQUAL expected_token)
      message(FATAL_ERROR "${name} changed the retained ownership token")
    endif()
  endif()
  set(last_profile "${active}" PARENT_SCOPE)
  set(last_output "${output}" PARENT_SCOPE)
  set(last_error "${error}" PARENT_SCOPE)
endfunction()

if(NOT PROFILE_RUNNER_ONLY)
  run_case(automatic "${PROFILE_PROBE_EXECUTABLE}" 0 removed success)
  set(first_profile "${last_profile}")
  set(ENV{SIMPLNX_TEST_ACTIVE_PROFILE} "${first_profile}")
  run_case(independent "${PROFILE_PROBE_EXECUTABLE}" 0 removed success)
  if(last_profile STREQUAL first_profile)
    message(FATAL_ERROR "Inherited active metadata reused the first child profile")
  endif()
endif()
run_case(round-trip "${PROFILE_TEST_EXECUTABLE}" 0 removed "Test profile saves and reloads an isolated witness" --reporter compact --warn NoTests)
if(NOT last_output MATCHES "Passed 1 test case")
  message(FATAL_ERROR "Round-trip probe did not execute its real Catch case")
endif()
run_case(discovery "${PROFILE_TEST_EXECUTABLE}" 1 removed "Test profile saves and reloads an isolated witness" --list-test-names-only)
string(STRIP "${last_output}" listed)
if(NOT listed STREQUAL "Test profile saves and reloads an isolated witness" OR NOT last_error STREQUAL "")
  message(FATAL_ERROR "Profile isolation changed discovery output: ${last_output}\n${last_error}")
endif()
run_case(help "${PROFILE_TEST_EXECUTABLE}" 0 removed --help)
if(NOT last_output MATCHES "--list-test-names-only" OR NOT last_error STREQUAL "")
  message(FATAL_ERROR "Profile runner did not preserve Catch help output")
endif()
run_case(invalid-cli "${PROFILE_TEST_EXECUTABLE}" 255 retained --simplnx-nonexistent-test-option)
string(FIND "${last_error}" "Error(s) in input:" parse_error)
if(parse_error LESS 0)
  message(FATAL_ERROR "Invalid CLI did not reach Catch argument validation")
endif()
# Catch opens the output stream while configuring the listing request. A regular-file
# ancestor forces that operation to throw without a test-only exception hook.
run_case(listing-error "${PROFILE_TEST_EXECUTABLE}" 255 retained --list-test-names-only --out "${case_root}/shared-artifact.txt/listing.txt")
if(NOT last_error MATCHES "Unable to open file:" OR NOT last_output STREQUAL "")
  message(FATAL_ERROR "Listing failure did not reach Catch output-stream setup: ${last_output}\n${last_error}")
endif()
if(NOT PROFILE_RUNNER_ONLY)
  run_case(full-discovery "${PROFILE_TEST_EXECUTABLE}" list removed --list-test-names-only)
  # Reuse actual discovered cases instead of adding synthetic product registrations.
  # This alphabet excludes Catch filter metacharacters, surrounding spaces, and CMake list separators.
  file(STRINGS "${case_root}/full-discovery.stdout" boundary_candidates REGEX "^[A-Za-z0-9][A-Za-z0-9 _:/().+-]*[A-Za-z0-9_:/().+-]$")
  list(LENGTH boundary_candidates boundary_candidate_count)
  if(boundary_candidate_count LESS 256)
    message(FATAL_ERROR "Listing boundary checks need 256 filter-safe existing names, found ${boundary_candidate_count}")
  endif()
  foreach(boundary_count IN ITEMS 255 256)
    list(SUBLIST boundary_candidates 0 ${boundary_count} boundary_names)
    list(JOIN boundary_names "\n" boundary_output)
    string(APPEND boundary_output "\n")
    set(boundary_input "${case_root}/listing-${boundary_count}.txt")
    file(WRITE "${boundary_input}" "${boundary_output}")
    set(boundary_status "${boundary_count}")
    if(NOT WIN32)
      math(EXPR boundary_status "${boundary_count} % 256")
    endif()
    run_case("listing-${boundary_count}" "${PROFILE_TEST_EXECUTABLE}" "${boundary_status}" removed --input-file "${boundary_input}" --list-test-names-only)
    if(NOT last_output STREQUAL boundary_output OR NOT last_error STREQUAL "")
      message(FATAL_ERROR "Listing ${boundary_count} did not preserve the exact selected names: ${last_output}\n${last_error}")
    endif()
  endforeach()
  run_case(catch-failure "${PROFILE_TEST_EXECUTABLE}" 1 retained "Test profile retains a failed run" --reporter compact --warn NoTests)
  if(NOT last_output MATCHES "Deliberate profile retention probe")
    message(FATAL_ERROR "Catch failure did not reach the intended assertion")
  endif()
  run_case(retained-owner "${PROFILE_TEST_EXECUTABLE}" 1 retained "Test profile detects a retained Application owner" --reporter compact --warn NoTests)
  if(NOT last_error MATCHES "Application owner remains")
    message(FATAL_ERROR "Retained owner did not reach the lifetime check")
  endif()
  run_case(save-failure "${PROFILE_TEST_EXECUTABLE}" 1 retained "Test profile detects an Application save failure" --reporter compact --warn NoTests)
  if(NOT last_error MATCHES "Test Application save failed")
    message(FATAL_ERROR "Save failure did not reach the checked Application save")
  endif()
  run_case(failure "${PROFILE_PROBE_EXECUTABLE}" 8 retained failure)
  run_case(unfinished "${PROFILE_PROBE_EXECUTABLE}" 9 retained unfinished)
  run_case(tamper "${PROFILE_PROBE_EXECUTABLE}" 8 tampered tamper)
  run_case(status-256-failure "${PROFILE_PROBE_EXECUTABLE}" 1 tampered status-256-failure)
  if(NOT last_error MATCHES "Test profile marker")
    message(FATAL_ERROR "Exit-status probe did not reach the controlled ownership failure")
  endif()
  set(success_256_status 0)
  if(WIN32)
    set(success_256_status 256)
  endif()
  run_case(status-256-success "${PROFILE_PROBE_EXECUTABLE}" "${success_256_status}" removed status-256-success)
  run_case(nested-owner "${PROFILE_PROBE_EXECUTABLE}" 8 retained nested-owner)
  run_case(root-replaced "${PROFILE_PROBE_EXECUTABLE}" 8 replaced root-replaced)
  run_case(late "${PROFILE_PROBE_EXECUTABLE}" 0 late late)

  set(expected_borrowed "${case_root}/borrowed")
  get_filename_component(borrowed_preferences_dir "${expected_borrowed}/${preferences_suffix}" DIRECTORY)
  file(MAKE_DIRECTORY "${borrowed_preferences_dir}")
  file(WRITE "${expected_borrowed}/.simplnx-test-profile" "${nonce}")
  set(borrowed_env "SIMPLNX_TEST_PROFILE_DIR=${expected_borrowed}" "SIMPLNX_TEST_PROFILE_TOKEN=${nonce}")
  run_case(borrowed-absent "${PROFILE_PROBE_EXECUTABLE}" 0 retained success)
  if(EXISTS "${expected_borrowed}/${preferences_suffix}")
    message(FATAL_ERROR "Bootstrap created an absent borrowed preferences file")
  endif()
  foreach(fixture IN ITEMS "{\"fixture\":31}" "malformed-json")
    file(WRITE "${expected_borrowed}/${preferences_suffix}" "${fixture}")
    string(MD5 fixture_id "${fixture}")
    run_case("borrowed-${fixture_id}" "${PROFILE_PROBE_EXECUTABLE}" 0 retained success)
    file(READ "${expected_borrowed}/${preferences_suffix}" actual)
    if(NOT actual STREQUAL fixture)
      message(FATAL_ERROR "Bootstrap changed a borrowed fixture")
    endif()
  endforeach()
  run_case(borrowed-failure "${PROFILE_PROBE_EXECUTABLE}" 8 retained failure)
  file(READ "${expected_borrowed}/${preferences_suffix}" after_failure)
  if(NOT after_failure STREQUAL "malformed-json")
    message(FATAL_ERROR "Failed borrowed completion changed its malformed fixture")
  endif()
  file(WRITE "${expected_borrowed}/${preferences_suffix}" "{\"plugins\":{},\"fixture\":31}")
  run_case(borrowed-round-trip "${PROFILE_TEST_EXECUTABLE}" 0 retained "Test profile saves and reloads an isolated witness" --reporter compact --warn NoTests)
  file(READ "${expected_borrowed}/${preferences_suffix}" saved)
  string(JSON witness GET "${saved}" profile_round_trip)
  string(JSON fixture GET "${saved}" fixture)
  if(NOT witness STREQUAL "731" OR NOT fixture STREQUAL "31")
    message(FATAL_ERROR "Borrowed Application save did not persist its witness and original fixture")
  endif()
  set(borrowed_env "SIMPLNX_TEST_PROFILE_DIR=${expected_borrowed}")
  run_case(missing-token "${PROFILE_PROBE_EXECUTABLE}" 3 rejected success)
  set(borrowed_env "SIMPLNX_TEST_PROFILE_TOKEN=${nonce}")
  run_case(missing-directory "${PROFILE_PROBE_EXECUTABLE}" 3 rejected success)
  set(borrowed_env "SIMPLNX_TEST_PROFILE_DIR=relative-profile" "SIMPLNX_TEST_PROFILE_TOKEN=${nonce}")
  run_case(relative "${PROFILE_PROBE_EXECUTABLE}" 3 rejected success)
  get_filename_component(filesystem_root "${case_root}" ABSOLUTE)
  cmake_path(GET filesystem_root ROOT_PATH filesystem_root)
  set(borrowed_env "SIMPLNX_TEST_PROFILE_DIR=${filesystem_root}" "SIMPLNX_TEST_PROFILE_TOKEN=${nonce}")
  run_case(root-path "${PROFILE_PROBE_EXECUTABLE}" 3 rejected success)
  set(borrowed_env "SIMPLNX_TEST_PROFILE_DIR=${expected_borrowed}" "SIMPLNX_TEST_PROFILE_TOKEN=wrong-token")
  run_case(mismatched-token "${PROFILE_PROBE_EXECUTABLE}" 3 rejected success)
  set(borrowed_env "SIMPLNX_TEST_PROFILE_DIR=${case_root}/fake-ambient" "SIMPLNX_TEST_PROFILE_TOKEN=${nonce}")
  run_case(missing-marker "${PROFILE_PROBE_EXECUTABLE}" 3 rejected success)
  file(MAKE_DIRECTORY "${case_root}/directory-marker/.simplnx-test-profile")
  set(borrowed_env "SIMPLNX_TEST_PROFILE_DIR=${case_root}/directory-marker" "SIMPLNX_TEST_PROFILE_TOKEN=${nonce}")
  run_case(directory-marker "${PROFILE_PROBE_EXECUTABLE}" 3 rejected success)
  file(CREATE_LINK "${expected_borrowed}" "${case_root}/linked-profile" SYMBOLIC RESULT link_result)
  if(link_result STREQUAL "0")
    set(borrowed_env "SIMPLNX_TEST_PROFILE_DIR=${case_root}/linked-profile" "SIMPLNX_TEST_PROFILE_TOKEN=${nonce}")
    run_case(linked-profile "${PROFILE_PROBE_EXECUTABLE}" 3 rejected success)
    set(borrowed_env "SIMPLNX_TEST_PROFILE_DIR=${case_root}/linked-profile/." "SIMPLNX_TEST_PROFILE_TOKEN=${nonce}")
    run_case(linked-profile-trailing-dot "${PROFILE_PROBE_EXECUTABLE}" 3 rejected success)
    # Remove the link itself before recursive driver cleanup.
    file(REMOVE "${case_root}/linked-profile")
  else()
    message(STATUS "Profile link rejection probe unavailable on this host: ${link_result}")
  endif()

  file(MAKE_DIRECTORY "${case_root}/alias-target/borrowed")
  file(CREATE_LINK "${case_root}/alias-target" "${case_root}/ancestor-alias" SYMBOLIC RESULT alias_result)
  if(alias_result STREQUAL "0")
    set(expected_borrowed "${case_root}/alias-target/borrowed")
    file(WRITE "${expected_borrowed}/.simplnx-test-profile" "${nonce}")
    get_filename_component(alias_preferences_dir "${expected_borrowed}/${preferences_suffix}" DIRECTORY)
    file(MAKE_DIRECTORY "${alias_preferences_dir}")
    file(WRITE "${expected_borrowed}/${preferences_suffix}" "{\"plugins\":{},\"alias_fixture\":91}")
    set(report_parent "${case_root}/ancestor-alias")
    set(borrowed_env "SIMPLNX_TEST_PROFILE_DIR=${case_root}/ancestor-alias/borrowed" "SIMPLNX_TEST_PROFILE_TOKEN=${nonce}")
    run_case(alias-ancestor "${PROFILE_PROBE_EXECUTABLE}" 0 retained success)
    run_case(alias-round-trip "${PROFILE_TEST_EXECUTABLE}" 0 retained "Test profile saves and reloads an isolated witness" --reporter compact --warn NoTests)
    file(READ "${expected_borrowed}/${preferences_suffix}" saved_alias)
    string(JSON alias_fixture GET "${saved_alias}" alias_fixture)
    string(JSON alias_witness GET "${saved_alias}" profile_round_trip)
    if(NOT alias_fixture STREQUAL "91" OR NOT alias_witness STREQUAL "731")
      message(FATAL_ERROR "Application did not use the borrowed fixture below the ancestor alias")
    endif()
    set(report_parent "${case_root}")
    file(REMOVE "${case_root}/ancestor-alias")
  else()
    message(STATUS "Profile ancestor-alias probe unavailable on this host: ${alias_result}")
  endif()

  file(MAKE_DIRECTORY "${case_root}/linked-marker-profile")
  file(CREATE_LINK "${expected_borrowed}/.simplnx-test-profile" "${case_root}/linked-marker-profile/.simplnx-test-profile" SYMBOLIC RESULT marker_link_result)
  if(marker_link_result STREQUAL "0")
    set(borrowed_env "SIMPLNX_TEST_PROFILE_DIR=${case_root}/linked-marker-profile" "SIMPLNX_TEST_PROFILE_TOKEN=${nonce}")
    run_case(linked-marker "${PROFILE_PROBE_EXECUTABLE}" 3 rejected success)
    file(REMOVE "${case_root}/linked-marker-profile/.simplnx-test-profile")
  else()
    message(STATUS "Profile marker-link rejection probe unavailable on this host: ${marker_link_result}")
  endif()

endif()

# This exact, uniquely created driver tree is caller-owned and all children have exited.
file(READ "${case_root}/.profile-driver" actual_token)
if(NOT actual_token STREQUAL nonce OR IS_SYMLINK "${case_root}")
  message(FATAL_ERROR "Driver ownership changed; evidence retained: ${case_root}")
endif()
file(REMOVE_RECURSE "${case_root}")
if(EXISTS "${case_root}")
  message(FATAL_ERROR "Cannot remove completed driver fixtures: ${case_root}")
endif()
