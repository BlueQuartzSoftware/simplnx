@ECHO OFF
setlocal

pushd "%~dp0"

REM Command file for Sphinx documentation

if not defined SPHINXBUILD (
	set "SPHINXBUILD=${SPHINX_BUILD_EXECUTABLE}"
)
if not defined SPHINXOPTS set "SPHINXOPTS=-W --keep-going"
set "SOURCEDIR=${SIMPLNX_SPHINX_DOCS_DIR}/source"
set "BUILDDIR=${SIMPLNX_SPHINX_DOCS_DIR}/build"
set "SPHINXLOG=${SIMPLNX_SPHINX_DOCS_DIR}/sphinx_build_output.log"

if "%1" == "" goto help

"%SPHINXBUILD%" >NUL 2>NUL
if errorlevel 9009 (
	echo.
	echo.The 'sphinx-build' command was not found. Make sure you have Sphinx
	echo.installed, then set the SPHINXBUILD environment variable to point
	echo.to the full path of the 'sphinx-build' executable. Alternatively you
	echo.may add the Sphinx directory to PATH.
	echo.
	echo.If you don't have Sphinx installed, grab it from
	echo.http://sphinx-doc.org/
	set "SPHINXSTATUS=1"
	goto end
)

"%SPHINXBUILD%" -M %1 "%SOURCEDIR%" "%BUILDDIR%" %SPHINXOPTS% %O% > "%SPHINXLOG%" 2>&1
set "SPHINXSTATUS=%ERRORLEVEL%"
if not "%SPHINXSTATUS%" == "0" type "%SPHINXLOG%"
goto end

:help
"%SPHINXBUILD%" -M help "%SOURCEDIR%" "%BUILDDIR%" %SPHINXOPTS% %O%
set "SPHINXSTATUS=%ERRORLEVEL%"

:end
popd
endlocal & exit /b %SPHINXSTATUS%
