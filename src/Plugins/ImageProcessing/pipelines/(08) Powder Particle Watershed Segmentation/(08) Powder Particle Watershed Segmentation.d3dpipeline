{
  "isDisabled": false,
  "name": "(08) Powder Particle Watershed Segmentation.d3dpipeline",
  "pipeline": [
    {
      "args": {
        "cell_attribute_matrix_name": {
          "value": "Cell Data",
          "version": 1
        },
        "center_origin": {
          "value": false,
          "version": 1
        },
        "change_image_data_type": {
          "value": false,
          "version": 1
        },
        "change_origin": {
          "value": false,
          "version": 1
        },
        "change_spacing": {
          "value": false,
          "version": 1
        },
        "cropping_options": {
          "value": {
            "bounds_x_physical": [
              0.0,
              0.0
            ],
            "bounds_x_voxels": [
              0,
              0
            ],
            "bounds_y_physical": [
              0.0,
              0.0
            ],
            "bounds_y_voxels": [
              0,
              0
            ],
            "bounds_z_physical": [
              0.0,
              0.0
            ],
            "bounds_z_voxels": [
              0,
              0
            ],
            "crop_x": true,
            "crop_y": true,
            "crop_z": true,
            "is_2d": true,
            "type": 0
          },
          "version": 1
        },
        "file_name": {
          "value": "Data/ImageProcessing_Examples/materials/powder_particles.png",
          "version": 1
        },
        "image_data_array_name": {
          "value": "Particle Intensity",
          "version": 1
        },
        "image_data_type_index": {
          "value": 0,
          "version": 1
        },
        "length_unit_index": {
          "value": 6,
          "version": 1
        },
        "origin": {
          "value": [
            0.0,
            0.0,
            0.0
          ],
          "version": 1
        },
        "origin_spacing_processing_index": {
          "value": 1,
          "version": 1
        },
        "output_geometry_path": {
          "value": "Powder Particles",
          "version": 1
        },
        "parameters_version": 1,
        "spacing": {
          "value": [
            1.0,
            1.0,
            1.0
          ],
          "version": 1
        }
      },
      "comments": "Import the source image and preserve its original pixel values.",
      "filter": {
        "name": "nx::core::ReadImageFilter",
        "uuid": "7391288d-3d0b-492e-93c9-e128e05c9737"
      },
      "isDisabled": false
    },
    {
      "args": {
        "input_image_data_path": {
          "value": "Powder Particles/Cell Data/Particle Intensity",
          "version": 1
        },
        "input_image_geometry_path": {
          "value": "Powder Particles",
          "version": 1
        },
        "maximum_error": {
          "value": [
            0.01,
            0.01,
            0.01
          ],
          "version": 1
        },
        "maximum_kernel_width": {
          "value": 16,
          "version": 1
        },
        "output_array_name": {
          "value": "Smoothed Particles",
          "version": 1
        },
        "parameters_version": 1,
        "use_image_spacing": {
          "value": true,
          "version": 1
        },
        "variance": {
          "value": [
            1.0,
            1.0,
            0.0
          ],
          "version": 1
        }
      },
      "comments": "Smooth small intensity variations before edge detection.",
      "filter": {
        "name": "nx::core::DiscreteGaussianImageFilter",
        "uuid": "2ddd8df9-a4d8-44e0-94b3-0776c1cdf096"
      },
      "isDisabled": false
    },
    {
      "args": {
        "input_image_data_path": {
          "value": "Powder Particles/Cell Data/Smoothed Particles",
          "version": 1
        },
        "input_image_geometry_path": {
          "value": "Powder Particles",
          "version": 1
        },
        "normalize_across_scale": {
          "value": false,
          "version": 1
        },
        "output_array_name": {
          "value": "Particle Gradient",
          "version": 1
        },
        "parameters_version": 1,
        "sigma": {
          "value": 1.0,
          "version": 1
        }
      },
      "comments": "Create a smooth edge-strength surface for watershed segmentation.",
      "filter": {
        "name": "nx::core::GradientMagnitudeRecursiveGaussianImageFilter",
        "uuid": "d9b71e00-6c15-4cb5-92bd-a8c2d9be57f2"
      },
      "isDisabled": false
    },
    {
      "args": {
        "fully_connected": {
          "value": true,
          "version": 1
        },
        "height": {
          "value": 5.0,
          "version": 1
        },
        "input_image_data_path": {
          "value": "Powder Particles/Cell Data/Particle Gradient",
          "version": 1
        },
        "input_image_geometry_path": {
          "value": "Powder Particles",
          "version": 1
        },
        "output_array_name": {
          "value": "Suppressed Minima",
          "version": 1
        },
        "parameters_version": 1
      },
      "comments": "Suppress shallow minima that would over-segment powder particles.",
      "filter": {
        "name": "nx::core::HMinimaImageFilter",
        "uuid": "2fea5169-5fa2-495f-87d7-e1dc5a73b890"
      },
      "isDisabled": false
    },
    {
      "args": {
        "background_value": {
          "value": 0.0,
          "version": 1
        },
        "flat_is_minima": {
          "value": true,
          "version": 1
        },
        "foreground_value": {
          "value": 1.0,
          "version": 1
        },
        "fully_connected": {
          "value": true,
          "version": 1
        },
        "input_image_data_path": {
          "value": "Powder Particles/Cell Data/Suppressed Minima",
          "version": 1
        },
        "input_image_geometry_path": {
          "value": "Powder Particles",
          "version": 1
        },
        "output_array_name": {
          "value": "Marker Mask",
          "version": 1
        },
        "parameters_version": 1
      },
      "comments": "Find the remaining regional minima as particle markers.",
      "filter": {
        "name": "nx::core::RegionalMinimaImageFilter",
        "uuid": "38b0d575-d728-49e9-9611-42c7df83c96c"
      },
      "isDisabled": false
    },
    {
      "args": {
        "fully_connected": {
          "value": true,
          "version": 1
        },
        "input_image_data_path": {
          "value": "Powder Particles/Cell Data/Marker Mask",
          "version": 1
        },
        "input_image_geometry_path": {
          "value": "Powder Particles",
          "version": 1
        },
        "output_array_name": {
          "value": "Marker Labels",
          "version": 1
        },
        "parameters_version": 1
      },
      "comments": "Assign a unique label to each watershed marker.",
      "filter": {
        "name": "nx::core::ConnectedComponentImageFilter",
        "uuid": "288f782b-9b8f-4734-ae66-15ae4a43db41"
      },
      "isDisabled": false
    },
    {
      "args": {
        "fully_connected": {
          "value": true,
          "version": 1
        },
        "input_image_data_path": {
          "value": "Powder Particles/Cell Data/Particle Gradient",
          "version": 1
        },
        "input_image_geometry_path": {
          "value": "Powder Particles",
          "version": 1
        },
        "mark_watershed_line": {
          "value": true,
          "version": 1
        },
        "marker_image_data_path": {
          "value": "Powder Particles/Cell Data/Marker Labels",
          "version": 1
        },
        "output_array_name": {
          "value": "Particle Labels",
          "version": 1
        },
        "parameters_version": 1
      },
      "comments": "Grow the particle markers across the gradient surface without merging touching particles.",
      "filter": {
        "name": "nx::core::MorphologicalWatershedFromMarkersImageFilter",
        "uuid": "5a489229-9421-4191-a059-04943147f7ed"
      },
      "isDisabled": false
    },
    {
      "args": {
        "background_value": {
          "value": 0.0,
          "version": 1
        },
        "fully_connected": {
          "value": true,
          "version": 1
        },
        "input_image_data_path": {
          "value": "Powder Particles/Cell Data/Particle Labels",
          "version": 1
        },
        "input_image_geometry_path": {
          "value": "Powder Particles",
          "version": 1
        },
        "output_array_name": {
          "value": "Particle Boundaries",
          "version": 1
        },
        "parameters_version": 1
      },
      "comments": "Extract the final particle boundaries.",
      "filter": {
        "name": "nx::core::LabelContourImageFilter",
        "uuid": "060339d1-56c9-4253-9b52-d4be6a58eafb"
      },
      "isDisabled": false
    },
    {
      "args": {
        "compression_level": {
          "value": 5,
          "version": 1
        },
        "export_file_path": {
          "value": "Data/Output/ImageProcessing_Examples/04_Powder_Watershed/powder_particles.dream3d",
          "version": 1
        },
        "parameters_version": 2,
        "use_compression": {
          "value": true,
          "version": 1
        },
        "write_xdmf_file": {
          "value": false,
          "version": 1
        }
      },
      "comments": "Save the separated powder-particle labels and intermediate images.",
      "filter": {
        "name": "nx::core::WriteDREAM3DFilter",
        "uuid": "b3a95784-2ced-41ec-8d3d-0242ac130003"
      },
      "isDisabled": false
    }
  ],
  "version": 1
}
