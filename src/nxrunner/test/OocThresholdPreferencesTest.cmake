cmake_minimum_required(VERSION 3.26)

foreach(required NXRUNNER_EXECUTABLE DEFAULTS_PROBE PIPELINE_FILE)
  if(NOT DEFINED ${required} OR NOT EXISTS "${${required}}")
    message(FATAL_ERROR "${required} was not supplied as an existing path")
  endif()
endforeach()
if(NOT DEFINED P1_ROOT_BASE OR "${P1_ROOT_BASE}" STREQUAL "" OR NOT IS_ABSOLUTE "${P1_ROOT_BASE}")
  message(FATAL_ERROR "P1_ROOT_BASE must be supplied as a nonempty absolute path; the directory need not exist")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/OocProcessExitStatus.cmake")

execute_process(COMMAND "${DEFAULTS_PROBE}" RESULT_VARIABLE probe_status OUTPUT_VARIABLE defaults_output TIMEOUT 30)
if(NOT probe_status STREQUAL "0")
  message(FATAL_ERROR "The local Preferences default probe failed: ${probe_status}")
endif()
string(REGEX MATCHALL "[0-9]+" defaults "${defaults_output}")
list(LENGTH defaults default_count)
if(NOT default_count EQUAL 2)
  message(FATAL_ERROR "The local Preferences default probe did not return exactly two byte counts: ${defaults_output}")
endif()
list(GET defaults 0 array_default)
list(GET defaults 1 structure_default)
set(expected_array_line "Warning -591: Preferences: saved Large Data Size ('large_data_size') value -1 (JSON type number_integer) is invalid. Allowed domain: 0 to 18446744073709551615 bytes. Using the default: ${array_default} bytes. Review this value in Preferences > Out of Core.")
set(expected_structure_line "Warning -591: Preferences: saved Large Data Structure Size ('large_datastructure_size') value \"bad\" (JSON type string) is invalid. Allowed domain: 0 to 18446744073709551615 bytes. Using the default: ${structure_default} bytes. Review this value in Preferences > Out of Core.")

# Formats a byte count as GB with two decimals (1 GB = 1024^3 bytes), rounded to the nearest 0.01 GB.
# A nonzero byte count that rounds to zero becomes 0.01 GB.
function(format_bytes_as_gb bytes output_variable)
  math(EXPR whole_gib "${bytes} / 1073741824")
  math(EXPR remainder_bytes "${bytes} % 1073741824")
  math(EXPR hundredths "${whole_gib} * 100 + (${remainder_bytes} * 100 + 536870912) / 1073741824")
  if(hundredths EQUAL 0 AND NOT bytes EQUAL 0)
    set(hundredths 1)
  endif()
  math(EXPR whole_part "${hundredths} / 100")
  math(EXPR fraction_part "${hundredths} % 100")
  if(fraction_part LESS 10)
    set(fraction_part "0${fraction_part}")
  endif()
  set(${output_variable} "${whole_part}.${fraction_part}" PARENT_SCOPE)
endfunction()
format_bytes_as_gb("${array_default}" array_default_gb)
format_bytes_as_gb("${structure_default}" structure_default_gb)
set(expected_array_gb_line "Warning -592: Preferences: saved Large Data Size ('large_data_size_gb') value -1 (JSON type number_integer) is invalid. Allowed domain: 0 to 17179869183.99 GB. Using the default: ${array_default_gb} GB. Review this value in Preferences > Out of Core.")
set(expected_structure_gb_line "Warning -592: Preferences: saved Large Data Structure Size ('large_datastructure_size_gb') value \"bad\" (JSON type string) is invalid. Allowed domain: 0 to 17179869183.99 GB. Using the default: ${structure_default_gb} GB. Review this value in Preferences > Out of Core.")

file(READ "${PIPELINE_FILE}" pipeline_template)
string(JSON source_format GET "${pipeline_template}" pipeline 1 args data_format value)
if(NOT source_format STREQUAL "HDF5-OOC")
  message(FATAL_ERROR "The preflight fixture's pipeline[1].args.data_format.value changed")
endif()
string(REGEX MATCHALL "\"value\"[ \t]*:[ \t]*\"HDF5-OOC\"" format_tokens "${pipeline_template}")
list(LENGTH format_tokens format_count)
if(NOT format_count EQUAL 1)
  message(FATAL_ERROR "The preflight fixture does not have one exact format token")
endif()
string(REPLACE "\"value\": \"HDF5-OOC\"" "\"value\": \"\"" pipeline "${pipeline_template}")
string(JSON selected_format GET "${pipeline}" pipeline 1 args data_format value)
if(NOT selected_format STREQUAL "")
  message(FATAL_ERROR "The owned preflight copy did not clear the explicit format")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)

foreach(profile_case IN ITEMS clean one_invalid both_invalid zero maximum gb_valid gb_invalid)
  set(case_root "${P1_ROOT_BASE}/${profile_case}-${nonce}")
  file(MAKE_DIRECTORY "${case_root}/temp" "${case_root}/AppData/Local/DREAM3DNX" "${case_root}/AppData/Roaming" "${case_root}/Library/Preferences/DREAM3DNX" "${case_root}/.config/DREAM3DNX")
  if(WIN32)
    set(preferences_file "${case_root}/AppData/Local/DREAM3DNX/preferences.json")
  elseif(APPLE)
    set(preferences_file "${case_root}/Library/Preferences/DREAM3DNX/preferences.json")
  else()
    set(preferences_file "${case_root}/.config/DREAM3DNX/preferences.json")
  endif()
  if(profile_case STREQUAL "clean")
    set(profile "{\"plugins\":{\"P1\":{\"keep\":17}}}")
    set(expected_count 0)
  elseif(profile_case STREQUAL "one_invalid")
    set(profile "{\"large_data_size\":-1,\"large_datastructure_size\":18446744073709551615,\"plugins\":{\"P1\":{\"keep\":17}}}")
    set(expected_count 1)
  elseif(profile_case STREQUAL "both_invalid")
    set(profile "{\"large_data_size\":-1,\"large_datastructure_size\":\"bad\",\"plugins\":{\"P1\":{\"keep\":17}}}")
    set(expected_count 2)
  elseif(profile_case STREQUAL "zero")
    set(profile "{\"large_data_size\":0,\"large_datastructure_size\":0,\"plugins\":{\"P1\":{\"keep\":17}}}")
    set(expected_count 0)
  elseif(profile_case STREQUAL "maximum")
    set(profile "{\"large_data_size\":18446744073709551615,\"large_datastructure_size\":18446744073709551615,\"plugins\":{\"P1\":{\"keep\":17}}}")
    set(expected_count 0)
  elseif(profile_case STREQUAL "gb_valid")
    set(profile "{\"large_data_size_gb\":1.5,\"large_datastructure_size_gb\":0.01,\"plugins\":{\"P1\":{\"keep\":17}}}")
    set(expected_count 0)
  else()
    set(profile "{\"large_data_size_gb\":-1,\"large_datastructure_size_gb\":\"bad\",\"plugins\":{\"P1\":{\"keep\":17}}}")
    set(expected_count 2)
  endif()
  file(WRITE "${preferences_file}" "${profile}")
  file(WRITE "${case_root}/input-preferences.json" "${profile}")
  file(WRITE "${case_root}/pipeline.d3dpipeline" "${pipeline}")

  set(ENV{HOME} "${case_root}")
  set(ENV{USERPROFILE} "${case_root}")
  set(ENV{LOCALAPPDATA} "${case_root}/AppData/Local")
  set(ENV{APPDATA} "${case_root}/AppData/Roaming")
  set(ENV{TEMP} "${case_root}/temp")
  set(ENV{TMP} "${case_root}/temp")
  set(ENV{TMPDIR} "${case_root}/temp")
  unset(ENV{SIMPLNX_OOC_FAULT_INJECT})
  execute_process(COMMAND "${NXRUNNER_EXECUTABLE}" --preflight "${case_root}/pipeline.d3dpipeline"
    WORKING_DIRECTORY "${case_root}" RESULT_VARIABLE run_status OUTPUT_FILE "${case_root}/stdout.txt"
    ERROR_FILE "${case_root}/stderr.txt" TIMEOUT 120)
  simplnx_classify_ooc_process_status("${run_status}" classification)
  if(NOT classification STREQUAL "SUCCESS")
    message(FATAL_ERROR "${profile_case} preflight failed with '${run_status}'; evidence: ${case_root}")
  endif()
  file(READ "${case_root}/stdout.txt" stdout)
  file(READ "${case_root}/stderr.txt" stderr)
  string(REGEX MATCHALL "Warning -59[12]: [^\r\n]+" corrections "${stderr}")
  list(LENGTH corrections correction_count)
  if(NOT correction_count EQUAL expected_count)
    message(FATAL_ERROR "${profile_case}: expected ${expected_count} corrections, got ${correction_count}; evidence: ${case_root}")
  endif()
  if(stdout MATCHES "Warning -59[12]:")
    message(FATAL_ERROR "${profile_case}: correction appeared on stdout; evidence: ${case_root}")
  endif()
  set(array_corrections 0)
  set(structure_corrections 0)
  foreach(correction IN LISTS corrections)
    string(STRIP "${correction}" correction)
    # Test the GB keys first: "large_data_size" is also part of "large_data_size_gb".
    if(correction MATCHES "large_data_size_gb")
      math(EXPR array_corrections "${array_corrections}+1")
      if(NOT correction STREQUAL expected_array_gb_line)
        message(FATAL_ERROR "${profile_case}: array GB correction differs from the exact core message; evidence: ${case_root}\n${correction}")
      endif()
    elseif(correction MATCHES "large_datastructure_size_gb")
      math(EXPR structure_corrections "${structure_corrections}+1")
      if(NOT correction STREQUAL expected_structure_gb_line)
        message(FATAL_ERROR "${profile_case}: structure GB correction differs from the exact core message; evidence: ${case_root}\n${correction}")
      endif()
    elseif(correction MATCHES "large_data_size")
      math(EXPR array_corrections "${array_corrections}+1")
      if(NOT correction STREQUAL expected_array_line)
        message(FATAL_ERROR "${profile_case}: array correction differs from the exact core message; evidence: ${case_root}\n${correction}")
      endif()
    elseif(correction MATCHES "large_datastructure_size")
      math(EXPR structure_corrections "${structure_corrections}+1")
      if(NOT correction STREQUAL expected_structure_line)
        message(FATAL_ERROR "${profile_case}: structure correction differs from the exact core message; evidence: ${case_root}\n${correction}")
      endif()
    else()
      message(FATAL_ERROR "${profile_case}: unexpected correction key; evidence: ${case_root}")
    endif()
  endforeach()
  if(profile_case STREQUAL "one_invalid" AND NOT array_corrections EQUAL 1)
    message(FATAL_ERROR "${profile_case}: expected one array correction; evidence: ${case_root}")
  endif()
  if((profile_case STREQUAL "both_invalid" OR profile_case STREQUAL "gb_invalid") AND (NOT array_corrections EQUAL 1 OR NOT structure_corrections EQUAL 1))
    message(FATAL_ERROR "${profile_case}: expected one correction for each field; evidence: ${case_root}")
  endif()
  if(profile_case STREQUAL "both_invalid" OR profile_case STREQUAL "gb_invalid")
    list(GET corrections 0 first_correction)
    list(GET corrections 1 second_correction)
    if(NOT first_correction MATCHES "large_data_size" OR NOT second_correction MATCHES "large_datastructure_size")
      message(FATAL_ERROR "${profile_case}: correction order changed; evidence: ${case_root}")
    endif()
  endif()
  file(READ "${preferences_file}" saved)
  string(JSON kept GET "${saved}" plugins P1 keep)
  if(NOT kept STREQUAL "17")
    message(FATAL_ERROR "${profile_case}: unrelated plugin value changed; evidence: ${case_root}")
  endif()
  # The file stores the thresholds in GB (1 GB = 1024^3 bytes) and never keeps a byte key.
  if(saved MATCHES "\"large_data_size\"[ \t]*:" OR saved MATCHES "\"large_datastructure_size\"[ \t]*:")
    message(FATAL_ERROR "${profile_case}: a byte threshold key was saved; evidence: ${case_root}")
  endif()
  if(profile_case STREQUAL "one_invalid" OR profile_case STREQUAL "maximum")
    if(NOT saved MATCHES "\"large_datastructure_size_gb\"[ \t]*:[ \t]*17179869183\\.99[ \t]*[,}]")
      message(FATAL_ERROR "${profile_case}: UINT64_MAX did not convert to 17179869183.99 GB; evidence: ${case_root}")
    endif()
  endif()
  if(profile_case STREQUAL "maximum" AND NOT saved MATCHES "\"large_data_size_gb\"[ \t]*:[ \t]*17179869183\\.99[ \t]*[,}]")
    message(FATAL_ERROR "${profile_case}: per-array UINT64_MAX did not convert to 17179869183.99 GB; evidence: ${case_root}")
  endif()
  if(profile_case STREQUAL "zero" AND (NOT saved MATCHES "\"large_data_size_gb\"[ \t]*:[ \t]*0\\.0[ \t]*[,}]" OR NOT saved MATCHES "\"large_datastructure_size_gb\"[ \t]*:[ \t]*0\\.0[ \t]*[,}]"))
    message(FATAL_ERROR "${profile_case}: zero threshold did not survive normal saving; evidence: ${case_root}")
  endif()
  if(profile_case STREQUAL "gb_valid" AND (NOT saved MATCHES "\"large_data_size_gb\"[ \t]*:[ \t]*1\\.5[ \t]*[,}]" OR NOT saved MATCHES "\"large_datastructure_size_gb\"[ \t]*:[ \t]*0\\.01[ \t]*[,}]"))
    message(FATAL_ERROR "${profile_case}: saved GB thresholds changed; evidence: ${case_root}")
  endif()
  if((profile_case STREQUAL "both_invalid" OR profile_case STREQUAL "gb_invalid") AND (saved MATCHES "large_data_size_gb" OR saved MATCHES "large_datastructure_size_gb"))
    message(FATAL_ERROR "${profile_case}: a repaired threshold was saved instead of its default; evidence: ${case_root}")
  endif()
endforeach()
